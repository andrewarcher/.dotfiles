[[ -f ~/.config/env_keys ]] && source ~/.config/env_keys

# add allowing hooks into zsh calls
autoload -Uz add-zsh-hook

##
## PATH - must come before any `$+commands[...]` guard below
##

# keep PATH/FPATH deduped, so nested shells don't accumulate entries.
# NOTE: -U only applies to *array* assignments, so append via `path=(x $path)`,
# not `export PATH="x:$PATH"`.
typeset -U path fpath

## mise - installs itself here, and this must precede the `$+commands[mise]`
## guard below as well as anything that resolves a mise-managed tool
path=("$HOME/.local/bin" $path)

## homebrew
#
# mise pours the formulae in config.toml straight into this prefix and does not
# install the `brew` binary, so the prefix has to go on PATH on its own rather
# than via `brew shellenv` -- a fresh machine has the formulae but no brew.
# When brew *is* installed, shellenv still runs for MANPATH/INFOPATH and the
# rest of its variables.
export HOMEBREW_PREFIX=/opt/homebrew
if [[ -d "${HOMEBREW_PREFIX}/bin" ]]; then
    path=("${HOMEBREW_PREFIX}/bin" "${HOMEBREW_PREFIX}/sbin" $path)
    fpath=("${HOMEBREW_PREFIX}/share/zsh/site-functions" $fpath)
fi
[[ -x "${HOMEBREW_PREFIX}/bin/brew" ]] && eval "$("${HOMEBREW_PREFIX}/bin/brew" shellenv)"

## pnpm
if (( $+commands[pnpm] )); then
    export PNPM_HOME="$HOME/Library/pnpm"
    path=("$PNPM_HOME" $path)

    # TURBOREPO - subgraphs stop caching at turborepo; rely on make caching instead
    export TURBO_OPTS="--force"
fi

## go
(( $+commands[go] )) && export GOPATH="$HOME/code/go"

## windsurf / devin
# Only its `devin-desktop` launcher lives here, so it goes last rather than ahead
# of every mise tool, as the installer's own appended `export PATH=` line put it.
# If the installer appends that line again, the precmd dedupe below removes the
# duplicate; delete the appended line when `mise dot diff` shows it.
[[ -d ~/.codeium/windsurf/bin ]] && path+=(~/.codeium/windsurf/bin)

# re-assign as an array to force -U dedupe over anything that prepended
# PATH as a scalar above (e.g. `brew shellenv`)
path=($path)

# Some installers append scalar `export PATH=` blocks to the END of this file --
# below the dedupe above, and not deduped by -U, so nested shells would
# otherwise accumulate copies. precmd runs once the whole file is sourced,
# wherever those blocks land. (Anything appended here is also a local edit to a
# file this repo owns; `mise dot diff` will show it.)
_dedupe_path() { path=($path) }
add-zsh-hook precmd _dedupe_path

##
## completion - compinit must run after fpath is set and before fzf-tab is sourced
##

autoload -Uz compinit && compinit

## AWS autocomplete
if (( $+commands[aws_completer] )); then
    autoload -Uz bashcompinit && bashcompinit
    complete -C "${commands[aws_completer]}" aws
fi

##
## prompt
##

# Add version control software info to zsh variables for prompt
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
# zstyle ':vcs_info:git*' formats $'%F{130}\UF126 %F{208}%b%f '
zstyle ':vcs_info:git*' formats $'%F{130}\uE725 %F{208}%b%f '
add-zsh-hook precmd vcs_info

## pretty prompt
PROMPT=$'%F{yellow}%D{%K:%M:%S} %F{84}%n%F{242}@%F{2}%m%F{242}:%F{31}%1~%f ${vcs_info_msg_0_}%# '

## Prompt live clock: 1 second timeout on resetting prompt
TMOUT=1
TRAPALRM() {
    if ! [[ "$WIDGET" =~ ^(complete-word|fzf-completion|fzf-file-widget|fzf-tab-complete|fzf-history-widget)$ ]]; then
        zle reset-prompt
    fi
}

## Prompt execution time
zmodload zsh/datetime
prompt_preexec() {
  prompt_prexec_realtime=${EPOCHREALTIME}
}
prompt_precmd() {
  if (( prompt_prexec_realtime )); then
    local -rF elapsed_realtime=$(( EPOCHREALTIME - prompt_prexec_realtime ))
    local -rF s=$(( elapsed_realtime%60 ))
    local -ri elapsed_s=${elapsed_realtime}
    local -ri m=$(( (elapsed_s/60)%60 ))
    local -ri h=$(( elapsed_s/3600 ))
    if (( h > 0 )); then
      printf -v prompt_elapsed_time '%ih%im' ${h} ${m}
    elif (( m > 0 )); then
      printf -v prompt_elapsed_time '%im%is' ${m} ${s}
    elif (( s >= 10 )); then
      printf -v prompt_elapsed_time '%.2fs' ${s} # 12.34s
    elif (( s >= 1 )); then
      printf -v prompt_elapsed_time '%.3fs' ${s} # 1.234s
    else
      printf -v prompt_elapsed_time '%ims' $(( s*1000 ))
    fi
    unset prompt_prexec_realtime
  else
    # Clear previous result when hitting ENTER with no command to execute
    unset prompt_elapsed_time
  fi
}
setopt nopromptbang prompt{cr,percent,sp,subst}
add-zsh-hook preexec prompt_preexec
add-zsh-hook precmd prompt_precmd
RPS1='%F{cyan}${prompt_elapsed_time}%F{none}'

##
## history
##

HISTFILE=~/.cache/zsh_history           # history file
HISTSIZE=1000000                        # number of history lines to keep in memory
SAVEHIST=2000000                        # number of history lines to keep in history file
setopt inc_append_history               # add commands to history immediately when entered
setopt hist_ignore_all_dups             # drop older duplicates of a command (implies hist_ignore_dups)
setopt hist_ignore_space                # do not record events starting with a space
# unsetopt share_history                  # do not share history between zsh sessions

## Basic hisotry search with arrow keys
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

##
## tool integrations
##

# fzf
if (( $+commands[fzf] )); then
    source <(fzf --zsh)
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'

    # https://github.com/Aloxaf/fzf-tab
    [[ -f ~/.config/zsh/fzf-tab/fzf-tab.plugin.zsh ]] && source ~/.config/zsh/fzf-tab/fzf-tab.plugin.zsh
    zstyle ':fzf-tab:*' default-color $'\033[33m'
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'lsd -1 --color=always $realpath'
fi

## lsd - `ls` replacement, configured by ~/.config/lsd/config.yaml
#
# Safe to shadow `ls` with: lsd drops colour, icons and its grid layout when
# stdout is not a tty, so `ls | wc -l` still reports one line per entry exactly
# as /bin/ls does. Aliases are not expanded in scripts either, so anything
# non-interactive keeps getting the real ls regardless.
#
# Not a complete drop-in: the BSD-only flags -b, -e and -O have no lsd
# equivalent. `command ls` reaches /bin/ls when one of those is needed.
(( $+commands[lsd] )) && alias ls=lsd

## direnv
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

# mise -- this is the interactive half of activation. ~/.zprofile (written by
# `[bootstrap.mise_shell_activate]`) puts the shim farm on PATH for everything
# that never sees a prompt; this puts the resolved tool paths ahead of those
# shims and exports mise's env vars, which shims alone do not do.
(( $+commands[mise] )) && eval "$(mise activate zsh)"

##
## editor
##

# git needs no core.editor entry -- it falls back to $EDITOR, so this stays the
# single source of truth. The guard falls back to the system vim on a machine
# where `mise bootstrap` has not run yet, rather than leaving a broken EDITOR
# mid-bootstrap.
if (( $+commands[nvim] )); then
    export EDITOR=nvim VISUAL=nvim
    alias vi=nvim vim=nvim
else
    export EDITOR=vim VISUAL=vim
fi

##
## misc
##

export LESSHISTFILE="$HOME/.cache/less/.lesshst"

show_colors () {
    for i in {0..255}; do
        print -Pn "%K{$i}  %k%F{$i}${(l:3::0:)i}%f " ${${(M)$((i%6)):#3}:+$'\n'};
     done
}
