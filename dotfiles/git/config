[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[pretty]
    oneLineDate = %C(blue)%h %C(green)%<(8,trunc)%ae %C(yellow)%ah%C(reset) %s%C(auto)%d
[alias]
    l = log --format=oneLineDate
    web = "!open \"$(git remote get-url origin | sed -E 's_^ssh://git@_https://_; s_^git@(.*):_https://\\1/_; s/\\.git$//')\""
    repull = "!git reset --hard origin/$(git branch --show-current)"
